# ==============================================================================
# LXION AI AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Backend: 9Router (Primary Gateway)
NINE_ROUTER_BASE_URL=https://9router.daeroom.my.id/v1
NINE_ROUTER_API_KEY=your_9router_api_key_here
DEFAULT_MODEL=auto

# Database (PostgreSQL + pgvector)
POSTGRES_USER=lxion
POSTGRES_PASSWORD=lxion_secret_2026
POSTGRES_DB=lxion_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lxion:lxion_secret_2026@localhost:5432/lxion_db

# Redis (Message bus / cache / celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Agent Core Settings
AGENT_NAME=LXION
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKSPACE_DIR=./workspace

# Multi-Channel Tokens
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WHATSAPP_SESSION_PATH=./whatsapp_sessions

# Tailscale Laptop Connector (Windows Companion)
COMPANION_HOST=100.x.x.x
COMPANION_PORT=9099
COMPANION_AUTH_TOKEN=